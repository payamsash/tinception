# Python cache files
**/__pycache__/

# Virtual environment
**/venv/
**/.env/
**/env/
**/.venv/

# IDE and editor files
**/.vscode/
**/.idea/
**/*.swp

# Pytest cache
.cache/

# OS-specific files
**/.DS_Store
**/Thumbs.db

# Ignore UKB data and master files
src/ukb/data/**
master_files/**
!master_files/**/*.csv
src/main/**.ipynb

# legacy/ keeps the old code only: no UKB-derived or subject-level data, no scratch notebooks (repo is public)
legacy/src/ukb/data/**
legacy/src/main/**.ipynb

# v2 local outputs (subject-level; they live on the SSD / cluster share)
cleanup/
qc/

# local documents (preregistration drafts etc.), not versioned
docs/
.pytest_cache/
.ruff_cache/
